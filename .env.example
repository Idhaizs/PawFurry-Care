# ==========================================
# PawFurry Care Malaysia - Environment Variables
# ==========================================

# Flask Application Secret Key (Generate random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# JWT Token Secret Key
JWT_SECRET=change-this-to-a-secure-jwt-secret-key

# Google Gemini AI API Key (Optional: Leave blank to use built-in veterinary knowledge engine)
GEMINI_API_KEY=

# Server Port (Default: 5000)
PORT=5000
